DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mihna_db

SECRET_KEY=replace_with_a_long_random_secret_key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# Account verification/recovery. Backend only; same values on every replica.
AUTH_CODE_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
EMAIL_FROM=Mihna <no-reply@your-verified-domain.example>
BREVO_API_KEY=replace_with_your_brevo_api_key
