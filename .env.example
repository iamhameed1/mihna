# Frontend: copy these values into frontend/.env.local (Vite reads from frontend).
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Backend: set this in backend/.env, alongside backend/.env.example settings.
# Must match VITE_GOOGLE_CLIENT_ID. No Google client secret is needed.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
