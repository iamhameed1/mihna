# Frontend: copy these values into frontend/.env.local (Vite reads from frontend).
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Backend: set this in backend/.env, alongside backend/.env.example settings.
# Must match VITE_GOOGLE_CLIENT_ID. No Google client secret is needed.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Account verification/recovery: BACKEND ONLY, never prefix these with VITE_.
# Generate a separate random secret of at least 32 characters; keep stable across replicas.
AUTH_CODE_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
EMAIL_FROM=Mihna <no-reply@your-verified-domain.example>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# SMTP_SECURITY: starttls (587), ssl (465), none (local mail catcher only).
